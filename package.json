{
  "name": "kmeans-wasm-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Development and release tooling for the kmeans-wasm npm package.",
  "license": "MIT",
  "packageManager": "npm@12.1.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.22.2 || ^24.15.0 || >=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.1.0",
      "onFail": "error"
    }
  },
  "allowScripts": {},
  "scripts": {
    "build": "wasm-pack build --release --target bundler && node scripts/finalize-npm-package.mjs pkg",
    "bench:rgb": "npm --prefix js_bench run bench:rgb",
    "bench:kmeans": "npm --prefix js_bench run bench:kmeans",
    "check": "npm run lint && npm test && npm run package:check",
    "lint": "cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings",
    "package:check": "npm run build && publint --strict pkg && attw --pack --profile esm-only pkg",
    "pages:build": "wasm-pack build --release --target web --out-dir docs/wasm",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "release:stage": "node scripts/stage-npm-release.mjs",
    "test": "cargo test --locked",
    "test:web": "wasm-pack test --chrome --headless"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@release-it/bumper": "^8.0.1",
    "publint": "^0.3.24",
    "release-it": "^21.1.0"
  }
}
